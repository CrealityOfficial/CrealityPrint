-  TWP(acxtail, bcytail, s1, s0);
-  TWP(acytail, bcxtail, t1, t0);
-  TTD(s1, s0, t1, t0, u3, u[2], u[1], u[0]);
-  u[3] = u3;
-  Dlength = _fesze(C2length, C2, 4, u, D);
-
-  return(D[Dlength - 1]);
-}
