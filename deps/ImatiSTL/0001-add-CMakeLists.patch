-  TWP(acx, bcytail, s1, s0);
-  TWP(acy, bcxtail, t1, t0);
-  TTD(s1, s0, t1, t0, u3, u[2], u[1], u[0]);
-  u[3] = u3;
-  C2length = _fesze(C1length, C1, 4, u, C2);
