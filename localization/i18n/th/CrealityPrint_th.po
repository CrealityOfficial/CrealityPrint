msgstr "Project-Id-Version: Creality Print \nReport-Msgid-Bugs-To: \nPOT-Creation-Date: 2026-06-26 22:56+0800\nPO-Revision-Date: \nLast-Translator: \nLanguage-Team: \nLanguage: th_TH\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=1; plural=0;\nX-Generator: Poedit 3.6"

msgid "Assembly"
msgstr "การประกอบ"

msgid "Loading of a model file failed."
msgstr "โหลดไฟล์โมเดลไม่สำเร็จ"

msgid "Meshing of a model file failed or no valid shape."
msgstr "สร้างเมชของไฟล์โมเดลล้มเหลวหรือไม่มีรูปทรงที่ถูกต้อง"

msgid "The supplied file couldn't be read because it's empty"
msgstr "ไม่สามารถอ่านไฟล์ที่ให้มาได้เนื่องจากไฟล์ว่างเปล่า"

msgid "Unknown file format. Input file must have .stl, .obj, .amf(.xml) extension."
msgstr "รูปแบบไฟล์ที่ไม่รู้จัก ไฟล์อินพุตต้องมีนามสกุล .stl, .obj หรือ .amf (.xml)"

msgid "Unknown file format. Input file must have .3mf or .zip.amf extension."
msgstr "รูปแบบไฟล์ที่ไม่รู้จัก ไฟล์อินพุตต้องมีนามสกุล .3mf หรือ .zip .amf"

msgid "Canceled"
msgstr "ยกเลิกแล้ว"

msgid "Generating walls"
msgstr "กำลังสร้างผนัง"

msgid "Generating infill regions"
msgstr "กำลังสร้างพื้นที่ infill"

msgid "Generating infill toolpath"
msgstr "กำลังสร้างเส้นทาง infill"

msgid "Detect overhangs for auto-lift"
msgstr "กำลังตรวจจับส่วนยื่นสำหรับ auto-lift"

msgid "Generating support"
msgstr "กำลังสร้างซัพพอร์ต"

msgid "Detecting support overhangs"
msgstr "กำลังตรวจหาส่วนยื่นที่ต้องใช้ซัพพอร์ต"

msgid "Processing support overhangs"
msgstr "กำลังประมวลผลส่วนยื่นของซัพพอร์ต"

msgid "Precalculating tree support"
msgstr "กำลังคำนวณซัพพอร์ตแบบต้นไม้ล่วงหน้า"

msgid "Propagating tree support branches"
msgstr "กำลังขยายกิ่งซัพพอร์ตแบบต้นไม้"

msgid "Generating tree support areas"
msgstr "กำลังสร้างพื้นที่ซัพพอร์ตแบบต้นไม้"

msgid "Generating support contact layers"
msgstr "กำลังสร้างชั้นสัมผัสของซัพพอร์ต"

msgid "Checking support necessity"
msgstr "กำลังตรวจสอบความจำเป็นของซัพพอร์ต"

msgid "floating regions"
msgstr "บริเวณลอย"

msgid "floating cantilever"
msgstr "คานยื่นลอย"

msgid "large overhangs"
msgstr "ส่วนยื่นขนาดใหญ่"

msgid "bridge overhangs"
msgstr "ส่วนยื่นแบบสะพาน"

#, possible-c-format, possible-boost-format
msgid "It seems object %s has %s. Please re-orient the object or enable support generation."
msgstr "ดูเหมือนว่าวัตถุ%sมี%sโปรดปรับทิศทางวัตถุใหม่หรือเปิดใช้งานการสนับสนุน"

msgid "Optimizing toolpath"
msgstr "กำลังปรับเส้นทางให้เหมาะสม"

msgid "Empty layers around bottom are replaced by nearest normal layers."
msgstr "เลเยอร์ว่างรอบๆ ด้านล่างจะถูกแทนที่ด้วยเลเยอร์ปกติที่ใกล้ที่สุด"

msgid "The model has too many empty layers."
msgstr "โมเดลมีชั้นว่างมากเกินไป"

msgid "Slicing mesh"
msgstr "กำลังสไลซ์เมช"

msgid "No layers were detected. You might want to repair your STL file(s) or check their size or thickness and retry.\n"
msgstr "ไม่พบเลเยอร์ใด ๆ คุณอาจต้องซ่อมแซมไฟล์ STL หรือตรวจสอบขนาดหรือความหนาแล้วลองใหม่อีกครั้ง\n"

msgid "An object's XY size compensation will not be used because it is also color-painted.\nXY Size compensation can not be combined with color-painting."
msgstr "การชดเชยขนาด XY ของวัตถุจะไม่ถูกใช้งานเพราะวัตถุนี้ถูกลงสีด้วย\nการชดเชยขนาด XY ไม่สามารถใช้ร่วมกับการลงสีได้"

msgid "An object has enabled XY Size compensation which will not be used because it is also fuzzy skin painted.\nXY Size compensation cannot be combined with fuzzy skin painting."
msgstr "วัตถุนี้เปิดใช้งานการชดเชยขนาด XY แต่จะไม่ถูกใช้เนื่องจากถูกวาดด้วยสกินที่เบลอเช่นกัน\nการชดเชยขนาด XY ไม่สามารถใช้ร่วมกับการวาดภาพสีผิวที่เบลอได้"

msgid "Object name"
msgstr "ชื่อวัตถุ"

msgid "Hollowing model"
msgstr "กำลังทำโมเดลให้กลวง"

msgid "Drilling holes into model."
msgstr "กำลังเจาะรูในโมเดล"

msgid "Slicing model"
msgstr "กำลังสไลซ์โมเดล"

msgid "Generating support points"
msgstr "กำลังสร้างจุดซัพพอร์ต"

msgid "Generating support tree"
msgstr "กำลังสร้างต้นไม้ซัพพอร์ต"

msgid "Generating pad"
msgstr "กำลังสร้างฐานรอง"

msgid "Slicing supports"
msgstr "กำลังสไลซ์ซัพพอร์ต"

msgid "Merging slices and calculating statistics"
msgstr "กำลังรวมชั้นสไลซ์และคำนวณสถิติ"

msgid "Rasterizing layers"
msgstr "กำลังแรสเตอร์ชั้น"

msgid "Slicing had to be stopped due to an internal error: Inconsistent slice index."
msgstr "การหั่นต้องยุติ เนื่องจากมีข้อผิดพลาดภายใน: ดัชนีส่วนตัดที่ไม่สอดคล้องกัน"

msgid "Visualizing supports"
msgstr "กำลังแสดงซัพพอร์ต"

msgid "No pad can be generated for this model with the current configuration"
msgstr "ไม่สามารถสร้างแผ่นสําหรับรุ่นนี้ได้โดยใช้การปรับแต่งปัจจุบัน"

msgid "There are unprintable objects. Try to adjust support settings to make the objects printable."
msgstr "มีวัตถุที่พิมพ์ไม่ได้ ลองปรับการตั้งค่าการรองรับเพื่อให้วัตถุสามารถพิมพ์ได้"

#, possible-boost-format
msgid "Failed to calculate line width of %1%. Can not get value of \"%2%\" "
msgstr "การคำนวณความกว้างของเส้นสำหรับ%1%ล้มเหลว ไม่สามารถรับค่าสำหรับ \"%2%\""

msgid "Invalid spacing supplied to Flow::with_spacing(), check your layer height and extrusion width"
msgstr "ระยะห่างที่ส่งให้ Flow::with_spacing() ไม่ถูกต้อง โปรดตรวจสอบความสูงชั้นและความกว้างการอัด"

msgid "Failed processing of the filename_format template."
msgstr "ไม่สามารถประมวลผลเทมเพลตรูปแบบชื่อไฟล์"

#, possible-boost-format
msgid "%1% is too close to exclusion area, there may be collisions when printing."
msgstr "%1%อยู่ใกล้พื้นที่ป้องกันมากเกินไปและอาจเกิดการชนกัน"

#, possible-boost-format
msgid "%1% is too close to others, and collisions may be caused."
msgstr "%1%อยู่ใกล้วัตถุอื่นมากเกินไปและอาจชนกัน"

#, possible-boost-format
msgid "%1% is too tall, and collisions will be caused."
msgstr "%1%สูงเกินไปและการชนกันจะเกิดขึ้น"

msgid " is too close to others, there may be collisions when printing."
msgstr "หากอยู่ใกล้วัตถุอื่นมากเกินไป อาจเกิดการชนกันระหว่างการพิมพ์"

msgid " is too close to exclusion area, there may be collisions when printing."
msgstr "หากอยู่ใกล้กับพื้นที่ที่ไม่สามารถพิมพ์ได้มากเกินไป อาจเกิดการชนกันระหว่างการพิมพ์"

msgid "Prime Tower"
msgstr "เสารองรับการไล่วัสดุ"

msgid " is too close to others, and collisions may be caused.\n"
msgstr "ใกล้กับวัตถุอื่นมากเกินไปและอาจเกิดการชนกัน\n"

msgid " is too close to exclusion area, and collisions will be caused.\n"
msgstr "ใกล้กับพื้นที่ที่ไม่สามารถพิมพ์ได้มากเกินไป จะเกิดการชนกัน\n"

msgid "Can not print multiple filaments which have large difference of temperature together. Otherwise, the extruder and nozzle may be blocked or damaged during printing"
msgstr "วัสดุที่มีความแตกต่างของอุณหภูมิมากเกินไปไม่สามารถพิมพ์ร่วมกันได้ มิฉะนั้นเครื่องอัดรีดและหัวฉีดอาจอุดตันหรือเสียหายระหว่างการพิมพ์"

msgid "No extrusions under current settings."
msgstr "ไม่มีการอัดรีดภายใต้การตั้งค่าปัจจุบัน"

msgid "Smooth mode of timelapse is not supported when \"by object\" sequence is enabled."
msgstr "ยังไม่รองรับโหมดการจับเวลาที่นุ่มนวล เมื่อมีการเปิดใช้งานลําดับ \"โดยวัตถุ\""

msgid "Please select \"By object\" print sequence to print multiple objects in spiral vase mode."
msgstr "โปรดเลือกลําดับการพิมพ์ \"โดยวัตถุ\" เพื่อพิมพ์วัตถุหลายชิ้นในโหมดแจกันแบบเกลียว"

msgid "The spiral vase mode does not work when an object contains more than one materials."
msgstr "ไม่รองรับโหมดแจกันหมุนในงานพิมพ์ที่มีวัสดุหลายชนิด"

#, possible-boost-format
msgid "The object %1% exceeds the maximum build volume height."
msgstr "อ็อบเจ็กต์%1%มีความสูงเกินความสูงของวอลุ่มบิลด์สูงสุด"

#, possible-boost-format
msgid "While the object %1% itself fits the build volume, its last layer exceeds the maximum build volume height."
msgstr "แม้ว่าออบเจ็กต์ \"%1%\" เองจะพอดีกับปริมาตรการพิมพ์ แต่เลเยอร์สุดท้ายก็เกินความสูงของปริมาตรการพิมพ์สูงสุดของเครื่องพิมพ์"

msgid "You might want to reduce the size of your model or change current print settings and retry."
msgstr "คุณอาจจะต้องการลดขนาดของรุ่นของคุณ หรือเปลี่ยนการตั้งค่าการพิมพ์ปัจจุบันและลองใหม่"

msgid "Variable layer height is not supported with Organic supports."
msgstr "ไม่รองรับความสูงชั้นตัวแปร"

msgid "Overhang Optimization is not supported with Organic supports."
msgstr "การปรับส่วนยื่นให้เหมาะสมไม่รองรับซัพพอร์ตแบบ Organic"

msgid "Wipe towers with different specifications are an experimental feature. Use with caution."
msgstr "หอเช็ดที่มีข้อกำหนดจำเพาะที่แตกต่างกันเป็นฟังก์ชันทดลอง โปรดใช้ด้วยความระมัดระวัง"

msgid "The Wipe Tower is currently only supported with the relative extruder addressing (use_relative_e_distances=1)."
msgstr "ขณะนี้รองรับการใช้ wipe tower เท่านั้นโดยระบุที่อยู่ของเครื่องอัดรีดแบบสัมพันธ์ (โดยใช้ระยะทางสัมพัทธ์=1)"

msgid "Ooze prevention is only supported with the wipe tower when 'single_extruder_multi_material' is off."
msgstr "Wipe Tower รองรับการป้องกันคราบสกปรกเฉพาะเมื่อปิด \"single_extruder_multi_material\" เท่านั้น"

msgid "The prime tower is currently only supported for the Marlin, RepRap/Sprinter, RepRapFirmware and Repetier G-code flavors."
msgstr "ขณะนี้ Wipe Tower รองรับเฉพาะรูปแบบ Marlin, RepRap/Sprinter, RepRapFirmware และ Repetier G-code เท่านั้น"

msgid "The prime tower is not supported in \"By object\" print."
msgstr "หอเช็ดไม่รองรับในโหมดการพิมพ์ทีละชิ้น"

msgid "The prime tower is not supported when adaptive layer height is on. It requires that all objects have the same layer height."
msgstr "ไม่รองรับการใช้หอเช็ดเมื่อเปิดความสูงของพื้นแบบแปรผัน กำหนดให้วัตถุทั้งหมดมีความสูงของชั้นเท่ากัน"

msgid "The prime tower requires \"support gap\" to be multiple of layer height"
msgstr "หอเช็ดทำความสะอาดกำหนดให้ \"ช่องว่างรองรับ\" เท่ากับผลคูณสำคัญของความสูงของพื้น"

msgid "The prime tower requires that all objects have the same layer heights"
msgstr "หอเช็ดต้องการให้วัตถุทั้งหมดมีความสูงของพื้นเท่ากัน"

msgid "The prime tower requires that all objects are printed over the same number of raft layers"
msgstr "หอคอยเช็ดต้องการให้แต่ละวัตถุใช้จำนวนชั้นแพเท่ากัน"

msgid "The prime tower requires that all objects are sliced with the same layer heights."
msgstr "หอเช็ดต้องการให้วัตถุทั้งหมดมีความสูงของพื้นเท่ากัน"

msgid "The prime tower is only supported if all objects have the same variable layer height"
msgstr "เสาหลักรองรับเมื่อวัตถุทั้งหมดมีความสูง ชั้นตัวแปรเดียวกัน"

msgid "Too small line width"
msgstr "ความกว้างของเส้นเล็กเกินไป"

msgid "Too large line width"
msgstr "ความกว้างของเส้นใหญ่เกินไป"

msgid "The prime tower requires that support has the same layer height with object."
msgstr "หอเช็ดต้องมีส่วนรองรับและวัตถุที่มีความสูงเท่ากัน"

msgid "Organic support tree tip diameter must not be smaller than support material extrusion width."
msgstr "เส้นผ่านศูนย์กลางปลายรองรับต้นไม้อินทรีย์จะต้องไม่เล็กกว่าความกว้างของการอัดขึ้นรูปวัสดุรองรับ"

msgid "Organic support branch diameter must not be smaller than 2x support material extrusion width."
msgstr "เส้นผ่านศูนย์กลางของกิ่งค้ำยันต้นอินทรีย์ต้องไม่น้อยกว่า 2 เท่าของความกว้างที่อัดขึ้นรูปของวัสดุค้ำยัน"

msgid "Organic support branch diameter must not be smaller than support tree tip diameter."
msgstr "เส้นผ่านศูนย์กลางของกิ่งรองรับของต้นไม้อินทรีย์ต้องไม่เล็กกว่าเส้นผ่านศูนย์กลางของปลายยอดไม้ค้ำ"

msgid "Support enforcers are used but support is not enabled. Please enable support."
msgstr "เปิดใช้งานตัวบังคับการรองรับ แต่ไม่รองรับ โปรดเปิดใช้การรองรับ"

msgid "This model contains painted support data. With organic supports, excessive painted support data may slow support generation."
msgstr "โมเดลนี้มีข้อมูลสนับสนุนที่วาดด้วยมือ เมื่อใช้การสนับสนุนทั่วไป ข้อมูลการสนับสนุนที่วาดด้วยมือมากเกินไปอาจทำให้การสร้างการสนับสนุนช้าลง"

msgid "Layer height cannot exceed nozzle diameter"
msgstr "ความสูงของชั้นต้องไม่เกินเส้นผ่านศูนย์กลางของหัวฉีด"

msgid "Relative extruder addressing requires resetting the extruder position at each layer to prevent loss of floating point accuracy. Add \"G92 E0\" to layer_gcode."
msgstr "การระบุตำแหน่งเครื่องอัดรีดแบบสัมพันธ์จำเป็นต้องรีเซ็ตตำแหน่งเครื่องอัดรีดในแต่ละชั้น เพื่อป้องกันการสูญเสียความแม่นยำของจุดลอยตัว เพิ่ม \"G92E0\" ลงในโค้ดเลเยอร์"

msgid "\"G92 E0\" was found in before_layer_gcode, which is incompatible with absolute extruder addressing."
msgstr "\"G92 E0\" พบใน before_layer_gcode ซึ่งไม่เข้ากันกับการอ้างอิงตำแหน่งหัวอัดแบบสัมบูรณ์"

msgid "\"G92 E0\" was found in layer_gcode, which is incompatible with absolute extruder addressing."
msgstr "\"G92 E0\" ถูกพบในชั้น gcode ซึ่งไม่สอดคล้องกันกับคําปราศรัยที่คมชัดที่สุด"

#, possible-c-format, possible-boost-format
msgid "Plate %d: %s does not support filament %s"
msgstr "ดิสก์%d:%sไม่รองรับเส้นใย%s"

#, possible-c-format, possible-boost-format
msgid "The flush multiplier setting is too low, value is %.2f"
msgstr "ตัวคูณฟลัชตั้งไว้ต่ำเกินไป ค่าคือ%.2f"

msgid "Setting the jerk speed too low could lead to artifacts on curved surfaces"
msgstr "ทําให้ความเร็วกระตุกต่ําเกินไป อาจนําไปสู่วัตถุบนพื้นผิวโค้ง"

msgid "The jerk setting exceeds the printer's maximum jerk (machine_max_jerk_x/machine_max_jerk_y).\nCrealityPrint will automatically cap the jerk speed to ensure it doesn't surpass the printer's capabilities.\nYou can adjust the maximum jerk setting in your printer's configuration to get higher speeds."
msgstr "การตั้งค่าเจิร์ก (jerk) เกินค่าเจิร์กสูงสุดของเครื่องพิมพ์ (machine_max_jerk_x/machine_max_jerk_y)\nCrealityPrint จะจำกัดความเร็วเจิร์กโดยอัตโนมัติเพื่อให้แน่ใจว่าไม่เกินความสามารถของเครื่องพิมพ์\nคุณสามารถปรับการตั้งค่าเจิร์กสูงสุดในการกำหนดค่าเครื่องพิมพ์เพื่อให้ได้ความเร็วสูงขึ้น"

msgid "The acceleration setting exceeds the printer's maximum acceleration (machine_max_acceleration_extruding).\nCrealityPrint will automatically cap the acceleration speed to ensure it doesn't surpass the printer's capabilities.\nYou can adjust the machine_max_acceleration_extruding value in your printer's configuration to get higher speeds."
msgstr "การตั้งค่าความเร่งเกินความเร่งสูงสุดของเครื่องพิมพ์ (machine_max_acceleration_extruding)\nCrealityPrint จะจำกัดความเร่งโดยอัตโนมัติเพื่อให้แน่ใจว่าไม่เกินความสามารถของเครื่องพิมพ์\nคุณสามารถปรับค่า machine_max_acceleration_extruding ในการกำหนดค่าเครื่องพิมพ์เพื่อให้ได้ความเร็วสูงขึ้น"

msgid "The travel acceleration setting exceeds the printer's maximum travel acceleration (machine_max_acceleration_travel).\nCrealityPrint will automatically cap the travel acceleration speed to ensure it doesn't surpass the printer's capabilities.\nYou can adjust the machine_max_acceleration_travel value in your printer's configuration to get higher speeds."
msgstr "การตั้งค่าความเร่งการเคลื่อนที่เกินความเร่งการเคลื่อนที่สูงสุดของเครื่องพิมพ์ (machine_max_acceleration_travel)\nCrealityPrint จะจำกัดความเร่งการเคลื่อนที่โดยอัตโนมัติเพื่อให้แน่ใจว่าไม่เกินความสามารถของเครื่องพิมพ์\nคุณสามารถปรับค่า machine_max_acceleration_travel ในการกำหนดค่าเครื่องพิมพ์เพื่อให้ได้ความเร็วสูงขึ้น"

msgid "Filament shrinkage will not be used because filament shrinkage for the used filaments differs significantly."
msgstr "การหดตัวของเส้นใยจะไม่ถูกนำมาใช้เนื่องจากการหดตัวของเส้นใยของเส้นใยที่ใช้จะแตกต่างกันอย่างมาก"

