msgstr "FB2860: Bộ đệm filament CFS bất thường."

msgid "FS2861: CFS left RFID board abnormal."
msgstr "FS2861: Bo RFID bên trái của CFS bất thường."

msgid "FS2862: CFS right RFID board abnormal."
msgstr "FS2862: Bo RFID bên phải của CFS bất thường."

msgid "The file where the last unexpected stop was detected"
msgstr "Tệp phát hiện lần dừng bất thường gần nhất"

