msgstr "Belt tension module error, left side belt communication line may be connected improperly."

msgid "Belt tension module error, right side belt tension module not calibrated, please recalibrate the module."
msgstr "Lỗi mô-đun căng thắt lưng, mô-đun căng dây bên phải không hiệu chỉnh, hãy điều chỉnh lại mô-đun."

msgid "Belt tension module error, left side belt tension module not calibrated, please recalibrate the module. "
msgstr "Lỗi mô-đun căng đai, mô-đun căng đai bên trái chưa được hiệu chuẩn, vui lòng hiệu chuẩn lại mô-đun. "

