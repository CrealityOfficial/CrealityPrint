msgstr "Lỗi nạp filament, filament có thể bị kẹt từ bộ nạp đến hub CFS. Vui lòng xử lý sự cố rồi nhấn nút &quot;Retry&quot;."


msgid ""
"Feed issue , filament may be blocked between the CFS hub and extruder "
"filament detector. Please resolve the issue and click &quot;Retry&quot; "
"button."
msgstr ""
"Lỗi nạp filament, filament có thể bị chặn giữa hub CFS và cảm biến filament của đầu đùn. Vui lòng xử lý sự cố rồi nhấn nút &quot;Retry&quot;."


msgid ""
"Feed issue , filament may be jammed between the extruder sensor and the "
"extruder gear. Please resolve the issue and click the &quot;Retry&quot; "
"button."
msgstr ""
"Lỗi nạp filament, filament có thể bị kẹt giữa cảm biến đầu đùn và bánh răng đầu đùn. Vui lòng xử lý sự cố rồi nhấn nút &quot;Retry&quot;."


msgid ""
"Feed issue , filament may be stuck between the CFS hub sensor and the gear. "
"Please resolve the issue and click the &quot;Retry&quot; button."
msgstr ""
"Lỗi nạp filament, filament có thể bị kẹt giữa cảm biến hub CFS và bánh răng. Vui lòng xử lý sự cố rồi nhấn nút &quot;Retry&quot;."


msgid "filament runs out, please refill."
msgstr "Dây buộc hết rồi."

msgid "Command failed, current scenario does not support this command."
msgstr "Lệnh bị lỗi, kịch bản hiện thời không hỗ trợ lệnh này."

msgid "Cutter issue, cutter might be jammed, please try again after resolving"
msgstr "Máy cắt có thể bị kẹt, hãy thử lại sau khi giải quyết xong."

msgid "RFID cannot be read, please manually edit filament"
msgstr "Không thể đọc được, xin vui lòng sửa đổi sợi dây bằng tay"

msgid ""
"PTFE tube may have detached from the pneumatic fitting, Printing paused, "
"please try again after resolving"
msgstr "Ống PTFE có thể đã tuột khỏi đầu nối khí nén. Đã tạm dừng in, vui lòng thử lại sau khi xử lý."


msgid "Extruder may be clogged. Click &quot;Retry&quot; after resolving."
msgstr "Thuốc trừ sâu có thể bị tắc. Nhấn &quot;Rery &quot; sau khi giải quyết."

msgid ""
"The filament buffer signal is abnormal,the buffer may be stuck or the "
"filament may be tangle."
msgstr "Tín hiệu đệm sợi là bất thường, bộ đệm có thể bị kẹt hoặc sợi tơ bị rối."


msgid "Filament may tangled, please try again after resolving"
msgstr "Đồ đạc có thể bị rối loạn, hãy thử lại sau khi giải quyết xong."

msgid "filament may be broken in CFS."
msgstr "Filament có thể bị đứt trong CFS."

msgid ""
"Retract issue, filament cannot be returned to CFS hub. Please resolve the "
"issue and click the &quot;Retry&quot; button."
msgstr "Lỗi rút filament, filament không thể quay về hub CFS. Vui lòng xử lý sự cố rồi nhấn nút &quot;Retry&quot;."


msgid ""
"Retract issue, filaments may be inserted into the CFS hub. Remove and click "
"the &quot;Retry&quot; button."
msgstr "Lỗi rút filament, filament có thể đã bị đưa vào hub CFS. Hãy lấy ra rồi nhấn nút &quot;Retry&quot;."


msgid ""
"Retract issue, Filament Buffer failure. Please resolve and click &quot;"
"Retry&quot; button."
msgstr "Vấn đề rút lại, thất bại. Hãy giải quyết và nhấn &quot; Hãy thử &quot; cái nút."

msgid ""
"TR2852: Filament detector triggered abnormally, possibly due to an external "
"material rack being used with CFS."
msgstr ""
"TR2852: Filament detector triggered abnormally, possibly due to an external "
"filament rack being used with CFS."

msgid "CFS temperature and humidity sensor abnormal."
msgstr "Thân nhiệt và cảm biến độ ẩm bất thường."

msgid ""
"TC2854: Filament detected in the extruder, affecting the cutter calibration. "
"Please remove the filament and try again."
msgstr "TC2854: Chất nổ phát hiện trong chất tẩy, ảnh hưởng đến khả năng cân bằng. Làm ơn bỏ sợi dây ra và thử lại."


msgid "TC2855: Cutter calibrat failed. Please try again after resolving."
msgstr "Cutter calibra thất bại. Hãy thử lại sau khi giải quyết xong."

msgid ""
"TC2856: Cutter issue, the cutter may be jammed or missing. Click &quot;"
"Retry&quot; after resolving."
msgstr "TC2856: Lỗi dao cắt, dao có thể bị kẹt hoặc bị thiếu. Nhấn &quot;Retry&quot; sau khi xử lý."


msgid ""
"CFS feeding motor overload, maybe excessive load or unload resistance or the "
"filament tangled or stuck."
msgstr "Có thể là quá tải hoặc quá tải kháng thể hoặc dây rối loạn hoặc bị kẹt."


msgid "FS2858: CFS EEPROM abnormal."
msgstr "FS2858:"

