msgid ""
"Line pattern of support interface. Default pattern for non-soluble support "
"interface is Rectilinear, while default pattern for soluble support "
"interface is Concentric"
msgstr "Pola garis antarmuka dukungan. Pola default untuk antarmuka dukungan yang tidak dapat larut adalah Rectilinear, sedangkan pola default untuk antarmuka dukungan yang dapat larut adalah Konsentris"

msgid "Rectilinear Interlaced"
msgstr "Interlaced Rektilinear"

